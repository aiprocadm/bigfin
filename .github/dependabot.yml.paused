# ⏸️ НА ПАУЗЕ до возобновления лимитов GitHub Actions (решение владельца,
# 2026-08-13). Dependabot работает на раннерах Actions и жёг минуты даже при
# выключенных Actions репозитория (прогоны 11–12.08, один — 55 минут).
#
# Вернуть: переименовать файл обратно в dependabot.yml — больше ничего не надо.
#
# Dependabot — автоматические PR на обновление зависимостей.
# Документация: https://docs.github.com/code-security/dependabot
version: 2

updates:
  # JS/TS зависимости (pnpm workspaces): корень + все пакеты монорепо.
  # Обновление pnpm-lock.yaml делает инфраструктура GitHub (не локальный pnpm install).
  - package-ecosystem: "npm"
    directories:
      - "/"
      - "/packages/server"
      - "/packages/webapp"
      - "/shared/email-components"
      - "/shared/pdf-templates"
      - "/shared/sdk-ts"
      - "/shared/utils"
    schedule:
      interval: "weekly"
    open-pull-requests-limit: 10
    commit-message:
      prefix: "chore(deps)"
    groups:
      # Низкорисковые обновления (minor + patch) — одним PR, чтобы не плодить шум.
      minor-and-patch:
        update-types:
          - "minor"
          - "patch"

  # Версии GitHub Actions в воркфлоу (.github/workflows/*).
  - package-ecosystem: "github-actions"
    directory: "/"
    schedule:
      interval: "weekly"
    commit-message:
      prefix: "chore(ci)"
